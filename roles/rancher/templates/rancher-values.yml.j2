# Helm values for Rancher — generated by Ansible from group_vars.
# Applied via: helm upgrade --install rancher ... -f this-file.yml
hostname: "{{ rancher_hostname }}"
tls: "{{ rancher_tls_source }}"
ingress:
  ingressClassName: "{{ rancher_ingress_class }}"
  extraAnnotations:
    # Tells Traefik to apply the https-proto middleware to Rancher's ingress.
    # The middleware injects X-Forwarded-Proto: https so Rancher knows the
    # original client request was HTTPS (even though NLB → Traefik is HTTP).
    # Without this Rancher sees plain HTTP and redirects → infinite loop.
    traefik.ingress.kubernetes.io/router.middlewares: "cattle-system-https-proto@kubernetescrd"
